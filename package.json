{
  "name": "war-of-the-three-kingdoms",
  "version": "2.0.0",
  "description": "三分天下：原创离线三国题材策略卡牌游戏",
  "private": true,
  "scripts": {
    "check": "node test/validate.js",
    "test:unit": "node test/validate.js && node test/unit.js && node test/dying_test.js",
    "test:sim": "node test/run.js 60 8",
    "test:stress": "node test/run.js 500 8",
    "test:ui": "python test/ui_features.py && python test/ui_play.py 5 0.05",
    "audit:assets": "python tools/audit_assets.py",
    "audit:assets:write": "python tools/audit_assets.py --write",
    "test": "npm run test:unit && npm run test:sim"
  },
  "engines": {
    "node": ">=14.0"
  },
  "devDependencies": {},
  "dependencies": {}
}
